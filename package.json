{
  "name": "@chnak/speak",
  "version": "1.0.0",
  "description": "Node.js 流媒体音频播放器，持久化 Speaker 实例",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node test.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "speaker": "^0.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": ["audio", "speaker", "stream", "playback", "typescript"],
  "repository": {
    "type": "git",
    "url": "https://github.com/chnak/speak"
  },
  "author": "chnak",
  "license": "MIT"
}